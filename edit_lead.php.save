        <?php

        $schema = [];
        $schemaquery = "
    SELECT COLUMN_NAME, COLUMN_TYPE 
    FROM INFORMATION_SCHEMA.COLUMNS 
    WHERE table_schema = '$database' AND table_name = 'leads'
 ";


        $schemaresult = $conn->query($schemaquery);
        // $schemaData = $schemaresult->fetch_assoc();
        // while ($row = mysqli_fetch_assoc($result)) {
        //     echo "Column: " . $row['COLUMN_NAME'] . " - Type: " . $row['COLUMN_TYPE'] . "<br>";
        // }
        if ($schemaresult && $schemaresult->num_rows > 0) {
            while ($row = mysqli_fetch_assoc($schemaresult)) {
                $schema[$row['COLUMN_NAME']] = $row['COLUMN_TYPE'];
            }
        }
        ?>
        <?php
        $count = 0;
        foreach ($leadData as $key => $lead) {
            $mysqlType = $schema[$key] ?? 'varchar';
            $inputType = getInputType($mysqlType);

            if ($count % 2 === 0) {
                // Start new row
                echo '<div class="form-row">';
            }
            echo '<div class="form-group form-col">';
            echo '<label for="' . $key . '">' . $key . '</label>';


            if ($key === 'services') {
                $selectedServices = explode(',', $lead);
                echo '<select id="' . $key . '" name="' . $key . '[]" multiple>';
                foreach ($additional_services as $option) {
                    $service_name = $option['service_name'];
                    $selected = in_array($service_name, $selectedServices) ? 'selected' : '';
                    echo '<option value="' . $service_name . '" ' . $selected . '>' . $service_name . '</option>';
                }
                echo '</select>';
            } else {
                $readonlyFields = ['id', 'client_id'];
                $readonlyAttr = in_array($key, $readonlyFields) ? 'readonly' : '';
                echo '<input type="' . $inputType . '" id="' . $key . '" name="' . $key . '" value="' . $lead . '" '.$readonlyAttr.'>';
            }
            echo '</div>'; // Close form-group
            $count++;
            if ($count % 2 === 0) {
                echo '</div>';
            }
        }
        if ($count % 2 !== 0) {
            echo '</div>'; // Close last unclosed form-row
        }
        ?>
        <button type="submit">Update Lead</button>
    </form>
