// Handle deletion via ?delete=1
if (isset($_GET['delete']) && $_GET['delete'] == 1 && $lead_id > 0) {
    $deleteQuery = "DELETE FROM leads WHERE id = $lead_id";
    if (mysqli_query($conn, $deleteQuery)) {
        echo "<script>alert('Lead deleted successfully.'); window.location.href='leads.php';</script>";
